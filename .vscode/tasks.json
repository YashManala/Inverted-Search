{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Inverted Search",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "main.c",
        "indexing.c",
        "database.c",
        "search.c",
        "-o",
        "inverted_search.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}